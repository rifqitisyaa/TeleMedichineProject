@model TeleMedichineProject.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sphaira — Staff Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; display: flex; height: 100vh; overflow: hidden; background: #ffffff; }

        /* LEFT: Sekarang bener-bener cuma background fokus */
        .left { 
            width: 65%; 
            position: relative;
            background-image: url('/images/LoginBackground.png');
            background-size: cover;
            background-position: center;
        }
        .left::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(27, 58, 107, 0.5) 0%, rgba(14, 165, 218, 0.2) 100%);
            z-index: 1;
        }

        /* RIGHT: Semua konten pindah sini */
        .right { 
            flex: 1; 
            background: white; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            padding: 0 8%; /* Pake persentase biar responsif */
            position: relative;
        }

        /* Logo pindah ke kanan atas biar tetap branding */
        .logo-container {
            position: absolute;
            top: 40px;
            left: 8%;
        }
        .logo { font-size: 24px; font-weight: 800; color: #1B3A6B; letter-spacing: -0.5px; }
        .logo span { color: #0ea5da; }

        .form-container { width: 100%; max-width: 400px; margin: 0 auto; }

        .portal-tag { 
            display: inline-flex; 
            align-items: center; 
            gap: 6px; 
            background: #F0F9FF; 
            color: #0369A1; 
            font-size: 11px; 
            font-weight: 700; 
            padding: 6px 14px; 
            border-radius: 50px; 
            margin-bottom: 24px; 
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .portal-dot { width: 6px; height: 6px; border-radius: 50%; background: #0EA5E9; animation: pulse 2s infinite; }

        .form-title { font-size: 32px; font-weight: 800; color: #1B3A6B; margin-bottom: 12px; letter-spacing: -0.02em; }
        .form-sub { font-size: 14px; color: #64748B; margin-bottom: 36px; line-height: 1.6; }

        /* FORM STYLING */
        .field { margin-bottom: 20px; }
        .field label { display: block; font-size: 12px; font-weight: 700; color: #1E293B; margin-bottom: 8px; letter-spacing: 0.05em; }
        .input-wrap { position: relative; }
        .input-wrap .icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; opacity: 0.7; }
        
        .field input {
            width: 100%; 
            padding: 14px 14px 14px 44px;
            border: 2px solid #F1F5F9; 
            border-radius: 12px;
            font-size: 14px; 
            font-family: inherit;
            background: #F8FAFC; 
            color: #1E293B; 
            outline: none;
            transition: all .2s ease;
        }
        .field input:focus { border-color: #0EA5E9; background: white; box-shadow: 0 0 0 4px rgba(14, 165, 218, 0.1); }
        
        .eye-btn { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #94A3B8; }

        .row { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; margin-bottom: 30px; }
        .remember { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #64748B; cursor: pointer; }
        .remember input { width: 16px; height: 16px; accent-color: #1B3A6B; }

        .btn-login { 
            width: 100%; 
            padding: 16px; 
            background: #1B3A6B; 
            color: white; 
            border: none; 
            border-radius: 12px; 
            font-size: 15px; 
            font-weight: 700; 
            cursor: pointer; 
            transition: all .3s; 
            box-shadow: 0 4px 12px rgba(27, 58, 107, 0.2);
        }
        .btn-login:hover { background: #0EA5E9; transform: translateY(-1px); box-shadow: 0 6px 15px rgba(14, 165, 218, 0.3); }

        .left-footer { 
            position: absolute; 
            bottom: 40px; 
            left: 8%; 
            font-size: 12px; 
            color: #CBD5E1; 
        }

        @@keyframes pulse {
            0% { transform: scale(0.95); opacity: 1; }
            70% { transform: scale(1.1); opacity: 0.7; }
            100% { transform: scale(0.95); opacity: 1; }
        }

        /* Error box styling benerin dikit */
        .error-box { 
            background: #FFF1F2; border: 1px solid #FECDD3; border-radius: 12px; 
            padding: 12px 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px;
        }
        .error-box span { color: #E11D48; font-size: 13px; font-weight: 600; }


@@media (max-width: 768px) {
    body {
        overflow-y: auto;
    }

    .left {
        display: none;
    }

    .right {
        width: 100%;
        flex: none;
        padding: 40px 24px;
        justify-content: flex-start;
        min-height: 100vh;
    }

    .logo-container {
        position: relative;
        top: 0;
        left: 0;
        margin-bottom: 40px;
        text-align: center;
    }

    .form-container {
        max-width: 100%;
    }

    .form-title {
        font-size: 26px;
    }

    .left-footer {
        position: static;
        margin-top: 40px;
        text-align: center;
        padding-bottom: 20px;
    }
}
    </style>
</head>
<body>

    <div class="left"></div>

    <div class="right">
        <div class="logo-container">
            <div class="logo"><span>S</span>phaira</div>
        </div>

        <div class="form-container">

            <div class="form-title">Sign In</div>
            <div class="form-sub"></div>

            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-box">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form asp-controller="Login" asp-action="PostLogin" method="post">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label>USERNAME</label>
                    <div class="input-wrap">
                        <span class="icon">
                            <svg width="18" height="18" fill="none" stroke="#64748B" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <input type="text" asp-for="Username" placeholder="Contoh: dr.budi" autocomplete="username" required />
                    </div>
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="field">
                    <label>PASSWORD</label>
                    <div class="input-wrap">
                        <span class="icon">
                            <svg width="18" height="18" fill="none" stroke="#64748B" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input type="password" asp-for="Password" id="passwordInput" placeholder="••••••••" autocomplete="current-password" required />
                        <button type="button" class="eye-btn" onclick="togglePassword()">
                            <svg id="eyeIcon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="row">
                    <label class="remember">
                        <input type="checkbox" /> Ingat saya di perangkat ini
                    </label>
                </div>

                <button type="submit" class="btn-login">Masuk ke Dashboard</button>
            </form>
        </div>
    </div>

    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
    </script>
</body>
</html>