@model IEnumerable<dynamic>

@if (Model != null && Model.Any())
{
    @foreach (var item in Model)
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden doctor-card border-start border-4 border-primary mb-3">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                            <i class="bi bi-person-badge-fill text-primary fs-2"></i>
                        </div>
                    </div>
                    <div class="col">
                        <h5 class="fw-bold mb-1 text-dark">@item.ParamedicName</h5>
                        <p class="text-muted mb-2 small">
                            <span class="badge bg-light text-primary border border-primary border-opacity-25 me-2">@item.SpecialtyCode </span>
                            <i class="bi bi-geo-alt me-1"></i> @item.GCParamedicType
                        </p>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-primary px-4 py-2 rounded-3 fw-bold">Buat Janji</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-search fs-1 mb-3"></i>
        <p>Dokter tidak ditemukan, coba cari nama lain.</p>
    </div>
}