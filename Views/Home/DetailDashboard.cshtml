<script>
// ── GLOBALS ──────────────────────────────────────────────────
const REGISTRATION = '@Model.Registration';
const MEDICAL_NO   = '@Model.MedicalNo';
            const PATIENT_PHONE = '@phone';
const PARAMEDIC_ID = @(_appUserLogin.ParamedicId);

let drugPage = 1, drugPageSize = 10, totalDrugPages = 1, drugKeyword = '';
let searchTimeout = null;

// ── LOOKUP STATE ─────────────────────────────────────────────
const lookupData     = { frequency: [], iu: [], route: [] };
const lookupFiltered = { frequency: [], iu: [], route: [] };

// ── NAVBAR DROPDOWN ──────────────────────────────────────────
function toggleProfile() {
    const dd = document.getElementById('profileDropdown');
    dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
}

document.addEventListener('click', e => {
    const dd = document.getElementById('profileDropdown');
    if (!e.target.closest('[onclick="toggleProfile()"]') && dd.style.display === 'block')
        dd.style.display = 'none';
});

// ── SIDEBAR SEARCH ───────────────────────────────────────────
function filterSidebar() {
    const q = document.getElementById('sidebarSearch').value.toLowerCase();
    document.querySelectorAll('#chatList .chat-item').forEach(item => {
        item.style.display = item.dataset.name.includes(q) ? '' : 'none';
    });
}

// ── MODALS ───────────────────────────────────────────────────
function openShare()      { document.getElementById('shareModal').style.display = 'flex'; }
function closeShare()     { document.getElementById('shareModal').style.display = 'none'; }
function openSoapModal()  { document.getElementById('soapHistoryModal').style.display = 'flex'; loadSoapHistory(); }
function closeSoapModal() { document.getElementById('soapHistoryModal').style.display = 'none'; }

function closeDrugConfig() {
    document.getElementById('drugConfigModal').style.display = 'none';
    document.getElementById('drugSearchInput').value = '';
    drugPage = 1;
    drugKeyword = '';
    fetchDrugList('', 1);
}

document.getElementById('shareModal').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeShare();
});
document.getElementById('soapHistoryModal').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeSoapModal();
});

// ── TOAST ─────────────────────────────────────────────────────
function showToast(msg, type = 'success') {
    const t = document.createElement('div');
    t.style.cssText = `
        position:fixed; bottom:80px; right:20px; z-index:9999;
        background:${type === 'success' ? '#16A34A' : '#EF4444'};
        color:white; padding:12px 18px; border-radius:10px;
        font-size:13px; font-weight:600; font-family:inherit;
        box-shadow:0 4px 16px rgba(0,0,0,.2);
    `;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 3000);
}

// ── SOAP ─────────────────────────────────────────────────────
async function saveSoap() {
    const s = document.getElementById('soapSubjective').value.trim();
    const o = document.getElementById('soapObjective').value.trim();
    const a = document.getElementById('soapAssessment').value.trim();
    const p = document.getElementById('soapPlan').value.trim();

    if (!s && !o && !a && !p) {
        alert('Please fill at least one SOAP field.');
        return;
    }

    const btn = document.getElementById('btnSaveSoap');
    btn.textContent = 'Saving...';
    btn.disabled = true;

    try {
        const res = await fetch('/Soap/SaveSoap', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ registrationNo: REGISTRATION, subjective: s, objective: o, assessment: a, planning: p })
        });
        const r = await res.json();
        if (r.success) {
            ['soapSubjective', 'soapObjective', 'soapAssessment', 'soapPlan'].forEach(id => {
                document.getElementById(id).value = '';
            });
            btn.textContent = '✓ Saved';
            btn.style.background = '#16A34A';
            setTimeout(() => {
                btn.textContent = 'Add SOAP';
                btn.style.background = '';
                btn.disabled = false;
            }, 2000);
        } else {
            alert('Failed: ' + r.message);
            btn.textContent = 'Add SOAP';
            btn.disabled = false;
        }
    } catch {
        alert('Connection error.');
        btn.textContent = 'Add SOAP';
        btn.disabled = false;
    }
}

