                prejoinPageEnabled: false,       // langsung masuk tanpa konfirmasi
                disableDeepLinking: true,
            },
            interfaceConfigOverwrite: {
                TOOLBAR_BUTTONS: [
                    'microphone', 'camera', 'hangup',
                    'chat', 'raisehand', 'tileview', 'fullscreen'
                ],
                SHOW_JITSI_WATERMARK: false,
                SHOW_BRAND_WATERMARK: false,
            }
        });

        // Auto close modal kalau hangup
        jitsiApi.addEventListener('readyToClose', () => {
            closeVideo();
        });
    }

    function closeVideo() {
        document.getElementById('videoModal').style.display = 'none';
        if (jitsiApi) {
            jitsiApi.dispose();
            jitsiApi = null;
            document.getElementById('jitsiContainer').innerHTML = '';
        }
    }

    // Tutup modal kalau klik di luar
    document.getElementById('videoModal').addEventListener('click', function(e) {
        if (e.target === this) closeVideo();
    });
</script> *@

<script>
    function openShare() {
    document.getElementById('shareModal').style.display = 'flex';
}
function closeShare() {
    document.getElementById('shareModal').style.display = 'none';
}
document.getElementById('shareModal').addEventListener('click', function(e) {
    if (e.target === this) closeShare();
});

function filterSidebar() {
    const q = document.getElementById('sidebarSearch').value.toLowerCase();
    document.querySelectorAll('#chatList .chat-item').forEach(item => {
        item.style.display = item.dataset.name.includes(q) ? '' : 'none';
    });
}
</script>

