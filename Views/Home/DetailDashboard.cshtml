        );
    } catch (e) { console.error('Failed to load Instruction', e); }
}


// ── PRESCRIPTION ──────────────────────────────────────────────
async function savePrescription() {
    const itemId = document.getElementById('drugConfigId').value;
    if (!itemId) { alert('Please select a drug first.'); return; }

    const btn = document.getElementById('btnSavePrescription');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
        const res = await fetch('/Prescription/SavePrescription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                registrationNo: REGISTRATION,
                items: [{
                    itemID:      parseInt(itemId),
                    dose:        parseFloat(document.getElementById('pres-dose').value)      || 1,
                    frequency:   document.getElementById('pres-frequency').value,
                    qty:         parseFloat(document.getElementById('pres-qty').value)       || 0,
                    itemUnit:    document.getElementById('pres-iu').value,
                    route:       document.getElementById('pres-route').value,
                    instruction:       document.getElementById('pres-instruction').value,
                    signa:       document.getElementById('pres-signa').value,
                    remarks:     document.getElementById('pres-remarks').value,
                    paramedicID: PARAMEDIC_ID
                }]
            })
        });
        const r = await res.json();
        if (r.success) {
            closeDrugConfig();
            await loadPrescriptionHistory();
            showToast('Prescription saved: ' + r.jobOrderNo);
        } else {
            alert('Failed: ' + r.message);
        }
    } catch {
        alert('Connection error.');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Save Prescription';
    }
}

