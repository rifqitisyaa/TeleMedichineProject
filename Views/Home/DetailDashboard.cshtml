                            async function downloadResepPDF() {
                const raw = document.getElementById('resepContent').innerHTML;
                const tag = 'script';
                const cleanContent = raw.replace(new RegExp('<' + tag + '\\b[^<]*(?:(?!<\\/' + tag + '>)<[^<]*)*<\\/' + tag + '>', 'gi'), '');

                const style = 'body{font-family:sans-serif;padding:32px;color:#1E293B;}';
                const parts = [
                    '<!DOCTYPE html><html><head><meta charset="UTF-8"/>',
                    '<style>', style, '</' + 'style>',
                    '</' + 'head><body>',
                    cleanContent,
                    '</' + 'body></' + 'html>'
                ];

                const blob = new Blob(parts, { type: 'text/html' });
                const url  = URL.createObjectURL(blob);
                const win  = window.open(url, '_blank');

                if (!win) {
                    alert('Popup diblokir browser! Izinkan popup untuk site ini.');
                    return;
                }

                setTimeout(function() {
                    win.focus();
                    win.print();
                    setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
                }, 800);
            }

