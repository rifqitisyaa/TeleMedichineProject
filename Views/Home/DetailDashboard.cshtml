    a.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
}

// ── DRUG SEARCH ───────────────────────────────────────────────
function searchDrugs(page = 1) {
    clearTimeout(searchTimeout);
    drugKeyword = document.getElementById('drugSearchInput').value.trim();
    drugPage = page;
    const delay = drugKeyword ? 300 : 0;
    searchTimeout = setTimeout(() => fetchDrugList(drugKeyword, page), delay);
}

async function fetchDrugList(term, page) {
    const listEl = document.getElementById('drugResultList');
    listEl.innerHTML = '<div style="padding:18px;text-align:center;font-size:13px;color:#94A3B8;">Loading...</div>';
    try {
        const res = await fetch(`/Prescription/SearchItems?term=${encodeURIComponent(term)}&page=${page}&pageSize=${drugPageSize}`);
        const data = await res.json();
        const items = data.items || data;
        const total = data.totalCount || items.length;
        totalDrugPages = Math.max(1, Math.ceil(total / drugPageSize));

        if (!items.length) {
            listEl.innerHTML = '<div style="padding:18px;text-align:center;font-size:13px;color:#94A3B8;">No medication found.</div>';
            updateDrugPagination();
            return;
        }

        listEl.innerHTML = items.map(item => `
            <div onclick="openDrugConfig(${item.id}, '${item.text.replace(/'/g, "\\'")}', '${(item.shortName || '').replace(/'/g, "\\'")}', '${item.unitCode ?? ''}')"
                 style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid #F1F5F9;cursor:pointer;"
                 onmouseover="this.style.background='#EFF6FF'"
                 onmouseout="this.style.background='white'">
                <div style="display:flex;align-items:center;gap:12px;">
                    <div style="width:32px;height:32px;border-radius:8px;background:#EFF6FF;display:flex;align-items:center;justify-content:center;flex-shrink:0;">💊</div>
                    <div style="font-size:13px;font-weight:600;color:#1E293B;">
                        ${item.shortName ? '[' + item.shortName + '] ' : ''}${item.text}
                    </div>
                </div>
                <div style="font-size:11px;color:#475569;text-align:right;flex-shrink:0;">
                    <div style="font-weight:600;color:#1E293B;">${item.stock ?? 0}</div>
                    <div style="color:#94A3B8;">${item.unit ?? '-'}</div>
                </div>
            </div>`).join('');

        updateDrugPagination();
    } catch {
        listEl.innerHTML = '<div style="padding:18px;text-align:center;font-size:13px;color:#EF4444;">Failed to load data.</div>';
    }
}

function updateDrugPagination() {
    document.getElementById('drugPageInfo').textContent = `Page ${drugPage} / ${totalDrugPages}`;
    document.getElementById('btnPrevDrug').style.opacity = drugPage <= 1 ? '.5' : '1';
    document.getElementById('btnNextDrug').style.opacity = drugPage >= totalDrugPages ? '.5' : '1';
}

function prevDrugPage() { if (drugPage > 1) searchDrugs(drugPage - 1); }
function nextDrugPage() { if (drugPage < totalDrugPages) searchDrugs(drugPage + 1); }

// ── DRUG CONFIG MODAL ─────────────────────────────────────────
function openDrugConfig(id, name, shortName, defaultUnitCode = null) {
    document.getElementById('drugConfigId').value = id;
    document.getElementById('drugConfigName').textContent = name;
    document.getElementById('drugConfigSub').textContent = shortName;

    // Reset number fields
    ['pres-qty', 'pres-freq', 'pres-duration'].forEach(fid => {
        document.getElementById(fid).value = '0';
    });
    document.getElementById('pres-dose').value = '1';
    document.getElementById('pres-signa').value = '';
    document.getElementById('pres-remarks').value = '';

    // Reset all lookup fields
    ['frequency', 'iu', 'route', 'instruction'].forEach(key => {
        document.getElementById(`pres-${key}-text`).value = '';
        document.getElementById(`pres-${key}`).value = '';
        hideLookup(key);
    });

    // Auto-select default item unit jika ada
    if (defaultUnitCode) {
        const match = lookupData.iu.find(i => i.value === defaultUnitCode);
        if (match) {
            document.getElementById('pres-iu-text').value = match.label;
            document.getElementById('pres-iu').value = match.value;
        }
    }

    document.getElementById('drugSearchInput').value = '';
    fetchDrugList('', 1);
    drugPage = 1;
    drugKeyword = '';
    document.getElementById('drugConfigModal').style.display = 'flex';
}

// ── RECALCULATE QTY ───────────────────────────────────────────
function recalQty() {
    const freq = parseFloat(document.getElementById('pres-freq').value) || 0;
    const dur  = parseFloat(document.getElementById('pres-duration').value) || 0;
    const dose = parseFloat(document.getElementById('pres-dose').value) || 0;

    if (freq > 0 && dur > 0) {
        document.getElementById('pres-qty').value   = freq * dur * dose;
        document.getElementById('pres-signa').value = `S ${freq}dd ${dose}`;
    }
}

// ── LOOKUP ENGINE ─────────────────────────────────────────────
function buildLookup(key, items, valueFn, labelFn, onSelect) {
    lookupData[key] = items.map(i => ({ value: valueFn(i), label: labelFn(i), raw: i }));
    lookupData[key]._onSelect = onSelect;
    lookupFiltered[key] = [...lookupData[key]];
}

function renderLookup(key, filtered) {
    const list = document.getElementById(`lookup-${key}`);
    if (!filtered.length) {
        list.innerHTML = '<div class="lookup-item empty">No results found</div>';
    } else {
        list.innerHTML = filtered.map((item, i) =>
            `<div class="lookup-item" onmousedown="selectLookup('${key}', ${i})">${item.label}</div>`
        ).join('');
    }
}

function filterLookup(key) {
    const q = document.getElementById(`pres-${key}-text`).value.toLowerCase();
    lookupFiltered[key] = lookupData[key].filter(i => i.label.toLowerCase().includes(q));
    renderLookup(key, lookupFiltered[key]);
    showLookup(key);
    document.getElementById(`pres-${key}`).value = '';
}

function showLookup(key) {
    // Kalau input masih kosong, tampilkan semua data
    if (!document.getElementById(`pres-${key}-text`).value) {
        lookupFiltered[key] = [...lookupData[key]];
        renderLookup(key, lookupFiltered[key]);
    }
    document.getElementById(`lookup-${key}`).classList.add('open');
}

function hideLookup(key) {
    document.getElementById(`lookup-${key}`).classList.remove('open');
}

function selectLookup(key, idx) {
    const item = lookupFiltered[key][idx];
    if (!item) return;

    document.getElementById(`pres-${key}-text`).value = item.label;
    document.getElementById(`pres-${key}`).value      = item.value;
    hideLookup(key);

    if (lookupData[key]._onSelect) lookupData[key]._onSelect(item.raw);
}

// Tutup semua lookup kalau klik di luar
document.addEventListener('click', e => {
    ['frequency', 'iu', 'route', 'instruction'].forEach(key => {
        const wrap = document.getElementById(`wrap-${key}`);
        if (wrap && !wrap.contains(e.target)) hideLookup(key);
    });
});

// ── LOAD LOOKUP DATA ──────────────────────────────────────────
async function loadFrequencyOptions() {
    try {
        const res  = await fetch('/Prescription/GetFrequencyTemplates');
        const data = await res.json();
        buildLookup('frequency', data,
            item => item.consumeMethodName,
            item => item.consumeMethodName,
            item => {
                const freq = parseFloat(item.frequency) || 0;
                const dur  = parseFloat(item.duration)  || 0;
                const dose = parseFloat(document.getElementById('pres-dose').value) || 0;
                if (freq > 0 && dur > 0) {
                    document.getElementById('pres-freq').value     = freq;
                    document.getElementById('pres-duration').value = dur;
                    document.getElementById('pres-qty').value      = freq * dur * dose;
                    document.getElementById('pres-signa').value    = `S ${freq}dd ${dose}`;
                }
            }
        );
    } catch (e) { console.error('Failed to load frequency templates', e); }
}

async function loadItemUnit() {
    try {
        const res  = await fetch('/Prescription/GetItemUnit');
        const data = await res.json();
        buildLookup('iu', data,
            item => item.itemUnitCode,
            item => item.itemUnitName,
            null
        );
    } catch (e) { console.error('Failed to load item units', e); }
}

async function loadRoute() {
