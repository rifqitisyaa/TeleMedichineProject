            function filterTable() {
                const search  = document.getElementById('searchInput').value.toLowerCase();
                const station = document.getElementById('filterSelect').value;
                const rows    = document.querySelectorAll('#tableBody tr');

                rows.forEach(row => {
                    const matchSearch  = !search  || row.dataset.patient.includes(search) || row.dataset.aptno.includes(search);
                    const matchStation = !station || row.dataset.station === station;
                    row.style.display  = (matchSearch && matchStation) ? '' : 'none';
                });
            }

}
