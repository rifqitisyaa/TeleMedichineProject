<script>
    async function loadSoapHistory() {
    const MedicalNo = '@Model.MedicalNo';
    if (!MedicalNo) return;

    const listEl = document.getElementById('soapHistoryListModal');

    try {
        const res = await fetch(`/Soap/GetSoapHistory?medicalNo=${MedicalNo}`);
        const result = await res.json();


        if (!result.success || result.data.length === 0) {
            listEl.innerHTML = '<div style="text-align:center; color:#94A3B8; padding:20px; font-size:13px;">Belum ada riwayat SOAP.</div>';
            return;
        }

        listEl.innerHTML = result.data.map((item, index) => {
            const date = new Date(item.notesDateTime);
            const dateStr = date.toLocaleDateString('id-ID', { 
                day: '2-digit', month: 'long', year: 'numeric' 
            });
            const timeStr = date.toLocaleTimeString('id-ID', { 
                hour: '2-digit', minute: '2-digit' 
            });

            const lines = item.notes?.split('\n') ?? [];
            const subjective  = lines.find(l => l.startsWith('SUBJECTIVE'))?.replace('SUBJECTIVE : ', '') ?? '-';
            const objective   = lines.find(l => l.startsWith('OBJECTIVE'))?.replace('OBJECTIVE : ', '') ?? '-';
            const assessment  = lines.find(l => l.startsWith('ASSESSMENT'))?.replace('ASSESSMENT : ', '') ?? '-';
            const planning    = lines.find(l => l.startsWith('PLANNING'))?.replace('PLANNING : ', '') ?? '-';

            return `
                <div style="border:1.5px solid #E2E8F0; border-radius:10px; overflow:hidden; margin-top:5px; margin-bottom:5px;">
                    <!-- Header (clickable) -->
                    <div onclick="toggleSoapItem(${index})"
                         style="display:flex; align-items:center; justify-content:space-between;
                                padding:12px 16px; cursor:pointer; background:#F8FAFC;
                                transition:background .15s;"
                         onmouseover="this.style.background='#EFF6FF'"
                         onmouseout="this.style.background='#F8FAFC'">
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div style="width:8px; height:8px; border-radius:50%; background:#2563EB; flex-shrink:0;"></div>
                            <div>
                                <div style="font-size:13px; font-weight:700; color:#1B3A6B;">${dateStr}</div>
                                <div style="font-size:11.5px; color:#94A3B8; margin-top:2px;">${timeStr} · ${item.paramedicName}</div>
                        </div>                            </div>

                        <svg id="arrow-${index}" width="16" height="16" fill="none" stroke="#94A3B8" 
                             stroke-width="2" viewBox="0 0 24 24"
                             style="transition:transform .2s; flex-shrink:0;">
                            <path d="m6 9 6 6 6-6"/>
                        </svg>
                    </div>

                    <!-- Content (expandable) -->
                    <div id="soapItem-${index}" style="display:none; padding:14px 16px;
                        border-top:1px solid #E2E8F0; flex-direction:column; gap:10px;">
                        ${['Subjective', 'Objective', 'Assessment', 'Planning'].map((label, i) => {
                            const values = [subjective, objective, assessment, planning];
                            return `
                                <div style="background:#F8FAFC; border-radius:8px; padding:10px 14px;">
                                    <div style="font-size:10.5px; font-weight:700; color:#1B3A6B; 
                                                text-transform:uppercase; letter-spacing:.4px; margin-bottom:4px;">
                                        ${label}
                                    </div>
                                    <div style="font-size:13px; color:#1E293B; line-height:1.5;">
                                        ${values[i]}
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                </div>
            `;
        }).join('');

    } catch (err) {
      listEl.innerHTML = '<div style="text-align:center; color:#EF4444; padding:40px; font-size:13px;">Gagal memuat riwayat.</div>';
    }
}

// Fungsi Modal
function openSoapModal() {
    document.getElementById('soapHistoryModal').style.display = 'flex';
    loadSoapHistory(); // load ulang setiap dibuka
}

function closeSoapModal() {
    document.getElementById('soapHistoryModal').style.display = 'none';
}

// Close modal kalau klik di luar
document.getElementById('soapHistoryModal').addEventListener('click', function(e) {
    if (e.target === this) closeSoapModal();
});

function toggleSoapItem(index) {
    const content = document.getElementById(`soapItem-${index}`);
    const arrow = document.getElementById(`arrow-${index}`);
    const isOpen = content.style.display === 'flex';
    
    content.style.display = isOpen ? 'none' : 'flex';
    arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
}

// Load history saat halaman ready
document.addEventListener('DOMContentLoaded', loadSoapHistory);


    async function saveSoap() {
    const subjective = document.getElementById('soapSubjective').value.trim();
    const objective  = document.getElementById('soapObjective').value.trim();
    const assessment = document.getElementById('soapAssessment').value.trim();
    const planning   = document.getElementById('soapPlan').value.trim();

    if (!subjective && !objective && !assessment && !planning) {
        alert('Mohon isi minimal satu field SOAP.');
        return;
    }

    const btn = document.getElementById('btnSaveSoap');
    btn.textContent = 'Menyimpan...';
    btn.disabled = true;

    try {
        const response = await fetch('/Soap/SaveSoap', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                registrationNo: '@Model.Registration',
                subjective,
                objective,
                assessment,
                planning
            })
        });

        const result = await response.json();

        if (result.success) {
            btn.textContent = '✓ Tersimpan';
            btn.style.background = '#16A34A';

            ['soapSubjective', 'soapObjective', 'soapAssessment', 'soapPlan'].forEach(id => {
        document.getElementById(id).value = '';
    });

    await loadSoapHistory();

            setTimeout(() => {
                btn.textContent = 'Simpan SOAP';
                btn.style.background = '#1B3A6B';
                btn.disabled = false;
            }, 2000);
        } else {
            alert('Gagal: ' + result.message);
            btn.textContent = 'Simpan SOAP';
            btn.disabled = false;
        }
    } catch (err) {
        alert('Terjadi kesalahan koneksi.');
        btn.textContent = 'Simpan SOAP';
        btn.disabled = false;
    }
}


function toggleProfile() {
    const dd = document.getElementById('profileDropdown');
    dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
}

document.addEventListener('click', function(e) {
    const dd = document.getElementById('profileDropdown');
    if (!e.target.closest('[onclick="toggleProfile()"]') && dd.style.display === 'block') {
        dd.style.display = 'none';
    }
});

    function openShare() {
    document.getElementById('shareModal').style.display = 'flex';
}
function closeShare() {
    document.getElementById('shareModal').style.display = 'none';
}
document.getElementById('shareModal').addEventListener('click', function(e) {
    if (e.target === this) closeShare();
});

function filterSidebar() {
    const q = document.getElementById('sidebarSearch').value.toLowerCase();
    document.querySelectorAll('#chatList .chat-item').forEach(item => {
        item.style.display = item.dataset.name.includes(q) ? '' : 'none';
    });

